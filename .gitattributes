* text=auto eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf
*.kt text eol=lf
*.svg text eol=lf

# Large experiment media through Git LFS: run "git lfs install" once.
*.wav filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.m4a filter=lfs diff=lfs merge=lfs -text
# Demo corpus is small and needed by CI/analysis tests without Git LFS:
data/demo/**/*.wav -filter -text -diff -merge
