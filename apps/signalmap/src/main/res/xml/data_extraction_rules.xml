<?xml version="1.0" encoding="utf-8"?>
<!-- 实验数据不上云；allowBackup=false 的同时显式声明提取规则（Android 12+ 要求）。 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
